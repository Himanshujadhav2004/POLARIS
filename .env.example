# Required for anything that scores claims (score, bench, fresh-set, dry-run, eval)
OPENAI_API_KEY=

# Only for `submit --yes` (sends an on-chain Geo proposal; submissions are paused)
# GEO_PRIVATE_KEY=

# Optional overrides
# OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=low
# GEO_API_URL=https://api-testnet.geobrowser.io/graphql
